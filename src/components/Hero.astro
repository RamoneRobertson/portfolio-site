---
import { site } from "../data/site";
import ProjectCarousel from "./ProjectCarousel.astro";
import { iconFor } from "../lib/icons";
---
<section class="hero" aria-labelledby="hero-name">
  <div class="glow" aria-hidden="true"></div>
  <div class="wrap hero-grid">
    <div class="hero-text">
      <ul class="certs" aria-label="Certifications">
        {site.certs.map((c) => {
          const icon = iconFor(c.icon)!;
          return (
            <li>
              <a class="cert" href={c.url} target="_blank" rel="noopener noreferrer" aria-label={`${c.issuer} ${c.name}: view badge (opens in a new tab)`}>
                <span class="cert-icon">
                  <svg viewBox="0 0 24 24" aria-hidden="true"
                    fill={icon.stroke ? "none" : "currentColor"}
                    stroke={icon.stroke ? "currentColor" : undefined}
                    stroke-width={icon.stroke ? 1.8 : undefined}
                    stroke-linecap="round" stroke-linejoin="round"><path d={icon.path} /></svg>
                </span>
                <span class="cert-text"><span class="issuer">{c.issuer}</span><span class="cert-name">{c.name}</span></span>
              </a>
            </li>
          );
        })}
      </ul>
      <p class="badge"><span class="dot" aria-hidden="true"></span>{site.availability}</p>
      <h1 id="hero-name">{site.name}</h1>
      <p class="role">{site.role} <span class="sep" aria-hidden="true">·</span> <span class="loc muted">{site.location}</span></p>
      <p class="intro">{site.intro}</p>
      <div class="actions">
        <a class="btn primary" href="#projects">
          View projects
          <svg class="arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
        </a>
        <a class="btn" href={`mailto:${site.email}`}>Email me</a>
        <span class="socials">
        <a class="icon-link" href={site.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.4c.58.11.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.25.45-2.28 1.19-3.08-.12-.3-.52-1.46.11-3.04 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.58.23 2.75.11 3.04.74.8 1.19 1.83 1.19 3.08 0 4.41-2.69 5.38-5.26 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.68.8.56A11.5 11.5 0 0 0 12 .5Z"/></svg>
        </a>
        <a class="icon-link" href={site.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"/></svg>
        </a>
        </span>
      </div>
    </div>

    <aside class="glance" aria-label="Featured projects">
      <ProjectCarousel />
    </aside>
  </div>

  <div class="wrap">
    <ul class="stats" data-reveal>
      {site.stats.map((s) => (
        <li>
          <strong>{s.value}</strong>
          <span>{s.label}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .hero { position: relative; padding-top: var(--s-12); padding-bottom: var(--s-16); overflow: hidden; }
  @media (min-width: 960px) { .hero { padding-top: var(--s-20); } }
  .glow {
    position: absolute; inset: -20% -10% auto 30%; height: 640px; z-index: -1; pointer-events: none;
    background: radial-gradient(closest-side, var(--glow), transparent);
    filter: blur(20px);
  }
  .hero-grid { display: grid; gap: var(--s-10); align-items: center; }
  @media (min-width: 960px) { .hero-grid { grid-template-columns: 1fr 360px; gap: var(--s-16); } }

  .certs { list-style: none; display: flex; flex-wrap: wrap; gap: var(--s-2); margin-bottom: var(--s-4); }
  .cert {
    display: inline-flex; align-items: center; gap: 10px; padding: 6px 14px 6px 6px;
    border: 1px solid var(--line); border-radius: var(--r-pill); background: var(--surface);
    text-decoration: none; transition: border-color 200ms var(--ease), transform 200ms var(--ease);
  }
  .cert:hover { border-color: var(--accent); transform: translateY(-1px); }
  .cert-icon { display: grid; place-items: center; width: 32px; height: 32px; border-radius: 50%; background: var(--accent-soft); color: var(--accent-text); }
  .cert-icon svg { width: 18px; height: 18px; }
  .cert-text { display: grid; line-height: 1.15; }
  .issuer { font-family: var(--mono); font-size: 11px; text-transform: uppercase; letter-spacing: 0.04em; color: var(--accent-text); }
  .cert-name { font-size: var(--t-xs); color: var(--ink); }

  .badge {
    display: inline-flex; align-items: center; gap: var(--s-2);
    padding: 6px 12px 6px 10px; border: 1px solid var(--line); border-radius: var(--r-pill);
    background: var(--surface); font-size: var(--t-xs); font-weight: 400; color: var(--ink-2);
  }
  .dot { position: relative; width: 8px; height: 8px; border-radius: 50%; background: var(--accent); }
  @media (prefers-reduced-motion: no-preference) {
    .dot::after { content: ""; position: absolute; inset: 0; border-radius: 50%; background: var(--accent); animation: ping 2.4s var(--ease) infinite; }
  }
  @keyframes ping { 0% { transform: scale(1); opacity: .6; } 80%, 100% { transform: scale(2.6); opacity: 0; } }

  h1 { margin-top: var(--s-6); font-size: var(--t-2xl); letter-spacing: -0.01em; line-height: 1; font-weight: 400; }
  .role { margin-top: var(--s-4); font-size: var(--t-lg); font-weight: 400; letter-spacing: -0.01em; }
  .sep { color: var(--muted); margin-inline: var(--s-1); }
  @media (max-width: 559px) { .sep { display: none; } .loc { display: block; font-size: var(--t-md); margin-top: var(--s-1); } }
  .socials { display: inline-flex; gap: var(--s-1); }
  .intro { margin-top: var(--s-6); max-width: 36rem; color: var(--ink-2); }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-3); margin-top: var(--s-8); }
  .icon-link { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; color: var(--muted); transition: color 200ms var(--ease), background-color 200ms var(--ease); }
  .icon-link:hover { color: var(--ink); background: var(--chip); }
  .icon-link svg { width: 20px; height: 20px; }

  .glance {
    background: var(--card); border: 1px solid var(--line); border-radius: var(--r-lg);
    padding: var(--s-5); box-shadow: var(--shadow);
  }
  @media (max-width: 959px) { .glance { max-width: 30rem; } }
  .stats {
    list-style: none; margin-top: var(--s-16);
    display: grid; grid-template-columns: repeat(2, 1fr);
    border-top: 1px solid var(--line);
  }
  @media (min-width: 820px) { .stats { grid-template-columns: repeat(4, 1fr); } }
  .stats li { display: grid; gap: var(--s-1); padding: var(--s-6) var(--s-4) 0 0; }
  .stats strong { font-size: clamp(1.75rem, 1.3rem + 1.6vw, 2.25rem); font-weight: 400; letter-spacing: -0.01em; line-height: 1.1; }
  .stats span { font-size: var(--t-sm); color: var(--muted); max-width: 14rem; }
</style>
