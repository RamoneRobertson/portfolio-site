---
import { Image, getImage } from "astro:assets";
import { site } from "../data/site";
const a = site.about;

// Each photo gets a grid thumbnail and a larger copy for the lightbox.
const photos = await Promise.all(
  a.life.photos.map(async (p) => ({
    ...p,
    large: await getImage({ src: p.src, width: Math.min(p.src.width, 1600), format: "webp" })
  }))
);
---
<section id="about" class="section" aria-labelledby="about-title">
  <div class="wrap about">
    <figure class="portrait" data-reveal>
      <img src={site.photo} alt={site.photoAlt} width="640" height="640" loading="lazy" />
    </figure>
    <div class="text" data-reveal>
      <p class="eyebrow">04 · About</p>
      <h2 id="about-title">{a.heading}</h2>
      <div class="bio">
        {a.paragraphs.map((p) => <p>{p}</p>)}
      </div>
      <dl class="facts">
        {a.facts.map((f) => (
          <div>
            <dt>{f.label}</dt>
            <dd>{f.value}</dd>
          </div>
        ))}
      </dl>

      <div class="life">
        <h3>{a.life.heading}</h3>
        {a.life.paragraphs.map((p) => <p>{p}</p>)}
        <ul class="gallery">
          {photos.map((p) => (
            <li>
              <a href={p.large.src} data-lightbox aria-label={`View photo: ${p.alt}`}>
                <Image src={p.src} alt={p.alt} width={480} loading="lazy" />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>

  <dialog class="lightbox" aria-label="Photo">
    <figure>
      <img alt="" />
      <figcaption></figcaption>
    </figure>
    <button class="lb-close" type="button" aria-label="Close photo">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
  </dialog>
</section>

<style>
  .about { display: grid; gap: var(--s-10); align-items: start; }
  @media (min-width: 960px) { .about { grid-template-columns: 380px 1fr; gap: var(--s-16); } }
  .portrait { margin: 0; max-width: 26rem; }
  @media (min-width: 960px) { .portrait { position: sticky; top: 96px; } }
  .portrait img {
    width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 25%;
    border-radius: var(--r-lg); border: 1px solid var(--line); box-shadow: var(--shadow);
  }
  h2 { margin-top: var(--s-3); font-size: var(--t-xl); max-width: 32rem; }
  .bio { display: grid; gap: var(--s-4); margin-top: var(--s-6); max-width: 38rem; color: var(--ink-2); }
  .bio p:first-child { color: var(--ink); font-size: var(--t-lg); line-height: 1.4; }
  .facts { display: grid; gap: 0; margin: var(--s-10) 0 0; max-width: 38rem; border-top: 1px solid var(--line); }
  .facts div { display: grid; grid-template-columns: 8rem 1fr; gap: var(--s-4); padding-block: var(--s-3); border-bottom: 1px solid var(--line); font-size: var(--t-sm); }
  dt { color: var(--muted); }
  dd { margin: 0; }

  .life { display: grid; gap: var(--s-3); margin-top: var(--s-12); max-width: 38rem; color: var(--ink-2); }
  .life h3 { font-size: var(--t-md); color: var(--ink); margin-bottom: var(--s-1); }
  .gallery { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--s-2); list-style: none; margin-top: var(--s-4); }
  .gallery a { display: block; overflow: hidden; border-radius: var(--r-sm); border: 1px solid var(--line); }
  .gallery img { display: block; width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; transition: transform 500ms var(--ease); }
  .gallery a:hover img { transform: scale(1.04); }

  .lightbox {
    max-width: min(92vw, 1100px); max-height: 90vh; padding: 0; border: 0; border-radius: var(--r-md);
    background: transparent; color: #fff; overflow: visible;
  }
  .lightbox::backdrop { background: rgba(0, 0, 0, 0.82); backdrop-filter: blur(4px); }
  .lightbox figure { margin: 0; }
  .lightbox img { display: block; max-width: 100%; max-height: 80vh; width: auto; height: auto; margin-inline: auto; border-radius: var(--r-md); }
  .lightbox figcaption { margin-top: var(--s-3); font-size: var(--t-sm); color: rgba(255, 255, 255, 0.75); text-align: center; }
  .lb-close {
    position: fixed; top: var(--s-4); right: var(--s-4); width: 44px; height: 44px; display: grid; place-items: center;
    border-radius: 50%; border: 1px solid rgba(255, 255, 255, 0.25); background: rgba(0, 0, 0, 0.4); color: #fff; cursor: pointer;
  }
  @media (prefers-reduced-motion: no-preference) {
    .lightbox[open] { animation: lb-in 300ms var(--ease); }
    @keyframes lb-in { from { opacity: 0; transform: scale(0.97); } }
  }
</style>

<script>
  // Photos open larger in a dialog. Without JS the link opens the image itself.
  const dialog = document.querySelector<HTMLDialogElement>(".lightbox");
  if (dialog && typeof dialog.showModal === "function") {
    const img = dialog.querySelector("img")!;
    const caption = dialog.querySelector("figcaption")!;
    document.querySelectorAll<HTMLAnchorElement>("[data-lightbox]").forEach((a) => {
      a.addEventListener("click", (e) => {
        e.preventDefault();
        const thumb = a.querySelector("img");
        img.src = a.href;
        img.alt = thumb?.alt ?? "";
        caption.textContent = thumb?.alt ?? "";
        dialog.showModal();
      });
    });
    dialog.querySelector(".lb-close")?.addEventListener("click", () => dialog.close());
    // Clicking the dark backdrop (outside the photo) closes it too.
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) dialog.close();
    });
  }
</script>
