---
import { site } from "../data/site";
import { iconFor } from "../lib/icons";
---
<section id="skills" class="section" aria-labelledby="skills-title">
  <div class="wrap">
    <header class="section-head" data-reveal>
      <p class="eyebrow">03 · Skills</p>
      <h2 id="skills-title">Tools I build with.</h2>
      <p>Everything here is used in the projects above.</p>
    </header>
    <dl class="skills" data-reveal>
      {site.skills.map((g) => (
        <div class="row">
          <dt>{g.name}</dt>
          <dd>
            <ul class="tools">
              {g.items.map((name) => {
                const icon = iconFor(name);
                return (
                  <li>
                    {icon && (
                      <svg viewBox="0 0 24 24" aria-hidden="true"
                        fill={icon.stroke ? "none" : "currentColor"}
                        stroke={icon.stroke ? "currentColor" : undefined}
                        stroke-width={icon.stroke ? 1.7 : undefined}
                        stroke-linecap="round" stroke-linejoin="round"><path d={icon.path} /></svg>
                    )}
                    {name}
                  </li>
                );
              })}
            </ul>
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .skills { margin: 0; border-top: 1px solid var(--line); }
  .row { display: grid; gap: var(--s-3); padding-block: var(--s-5); border-bottom: 1px solid var(--line); }
  @media (min-width: 820px) { .row { grid-template-columns: 14rem 1fr; gap: var(--s-6); align-items: baseline; } }
  dt { font-weight: 400; font-size: var(--t-sm); }
  dd { margin: 0; }
  .tools { list-style: none; display: flex; flex-wrap: wrap; gap: var(--s-2); }
  .tools li {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 7px 12px 7px 10px; border-radius: var(--r-pill);
    background: var(--accent-soft); border: 1px solid transparent; color: var(--accent-text); font-size: var(--t-xs);
    transition: border-color 200ms var(--ease);
  }
  .tools svg { width: 16px; height: 16px; flex: none; }
  .tools li:hover { border-color: var(--accent); }
</style>
