---
import { existsSync } from "node:fs";
import { site } from "../data/site";

// Show the resume button only once public/resume.pdf exists.
const hasResume = existsSync("public/resume.pdf");
const links = [
  { href: "/#projects", label: "Projects" },
  { href: "/#experience", label: "Experience" },
  { href: "/#skills", label: "Skills" },
  { href: "/#about", label: "About" },
  { href: "/#contact", label: "Contact" }
];
---
<header class="bar">
  <div class="wrap bar-in">
    <a class="brand" href="/" aria-label={`${site.name}, home`}>
      <img src={site.photo} alt="" width="28" height="28" />
      <span>{site.name}</span>
    </a>
    <nav aria-label="Sections">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
    <div class="bar-actions">
      <button class="icon-btn" id="theme-toggle" type="button" aria-label="Switch color theme">
        <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"/></svg>
      </button>
      {hasResume
        ? <a class="btn primary sm" href="/resume.pdf" target="_blank" rel="noopener">Resume</a>
        : <a class="btn primary sm" href={`mailto:${site.email}`}>Get in touch</a>}
    </div>
  </div>
</header>

<style>
  .bar {
    position: sticky; top: 0; z-index: 40;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    border-bottom: 1px solid transparent;
    transition: border-color 200ms var(--ease);
  }
  :global(.scrolled) .bar { border-bottom-color: var(--line); }
  .bar-in { display: flex; align-items: center; gap: var(--s-3); height: 64px; }
  @media (min-width: 820px) { .bar-in { gap: var(--s-6); } }
  .brand { display: flex; align-items: center; gap: var(--s-2); text-decoration: none; font-weight: 400; letter-spacing: -0.01em; white-space: nowrap; }
  .brand img { width: 28px; height: 28px; border-radius: 50%; object-fit: cover; }
  nav { display: none; gap: var(--s-1); }
  nav a { padding: var(--s-2) var(--s-3); border-radius: var(--r-pill); font-size: var(--t-sm); color: var(--muted); text-decoration: none; transition: color 200ms var(--ease), background-color 200ms var(--ease); }
  nav a:hover { color: var(--ink); background: var(--chip); }
  .bar-actions { display: flex; align-items: center; gap: var(--s-2); margin-left: auto; }
  @media (min-width: 820px) {
    nav { display: flex; margin-left: auto; }
    nav + .bar-actions { margin-left: 0; }
  }
  .btn.sm { height: 36px; padding: 0 var(--s-4); }
  .icon-btn { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 50%; border: 0; background: transparent; color: var(--muted); cursor: pointer; transition: color 200ms var(--ease), background-color 200ms var(--ease); }
  .icon-btn:hover { color: var(--ink); background: var(--chip); }
  .icon-btn svg { width: 18px; height: 18px; }
  /* Show the theme you'd switch TO: a moon in light mode, a sun in dark mode. */
  .sun { display: none; }
  :global([data-theme="dark"]) .moon { display: none; }
  :global([data-theme="dark"]) .sun { display: block; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .moon { display: none; }
    :global(:root:not([data-theme="light"])) .sun { display: block; }
  }
  @media (max-width: 340px) { .brand span { display: none; } }
</style>
