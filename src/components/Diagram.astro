---
// Left-to-right architecture flow. Columns stack vertically on narrow screens.
interface Props {
  columns: string[][];
  tone?: "light" | "dark";
  label: string;
}
const { columns, tone = "light", label } = Astro.props;
const parse = (s: string) => {
  const [name, detail] = s.split("|").map((p) => p.trim());
  return { name, detail };
};
---
<figure class:list={["diagram", tone]} aria-label={label}>
  <ol>
    {columns.map((col, i) => (
      <li class="col">
        {col.map((node) => {
          const n = parse(node);
          return (
            <div class="node">
              <span class="name">{n.name}</span>
              {n.detail && <span class="detail">{n.detail}</span>}
            </div>
          );
        })}
        {i < columns.length - 1 && <span class="link" aria-hidden="true" />}
      </li>
    ))}
  </ol>
</figure>

<style>
  .diagram {
    margin: 0; padding: var(--s-5); border-radius: var(--r-md);
    background-color: var(--d-bg);
    background-image: radial-gradient(var(--d-dot) 1px, transparent 1px);
    background-size: 16px 16px;
    border: 1px solid var(--d-line);
    --d-bg: var(--bg); --d-dot: var(--line); --d-line: var(--line);
    --d-node: var(--surface); --d-ink: var(--ink); --d-muted: var(--muted); --d-wire: var(--muted);
  }
  .diagram.dark {
    --d-bg: var(--panel-2); --d-dot: var(--panel-line); --d-line: var(--panel-line);
    --d-node: var(--panel); --d-ink: var(--panel-ink); --d-muted: var(--panel-muted); --d-wire: var(--panel-muted);
  }
  ol { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--s-6); }
  .col { position: relative; display: flex; flex-wrap: wrap; justify-content: center; gap: var(--s-2); }
  .node {
    display: grid; gap: 2px; text-align: center; min-width: 8.5rem;
    padding: var(--s-2) var(--s-3); border-radius: var(--r-sm);
    background: var(--d-node); border: 1px solid var(--d-line); color: var(--d-ink);
  }
  .name { font-size: 15px; font-weight: 400; line-height: 1.3; }
  .detail { font-family: var(--mono); font-size: 11px; color: var(--d-muted); line-height: 1.3; }
  /* vertical connector below each column */
  .link { position: absolute; left: 50%; bottom: calc(-1 * var(--s-6)); height: var(--s-6); width: 1px; background: var(--d-wire); opacity: .6; }
  .link::after { content: ""; position: absolute; bottom: 0; left: -3px; border: 3.5px solid transparent; border-top: 5px solid var(--d-wire); border-bottom: 0; }

  @media (min-width: 1100px) {
    ol { flex-direction: row; align-items: center; gap: var(--s-8); }
    .col { flex-direction: column; flex: 1; min-width: 0; }
    .node { min-width: 0; }
    .link { left: auto; right: calc(-1 * var(--s-8)); bottom: auto; top: 50%; width: var(--s-8); height: 1px; }
    .link::after { bottom: auto; left: auto; right: 0; top: -3px; border: 3.5px solid transparent; border-left: 5px solid var(--d-wire); border-right: 0; }
  }
</style>
